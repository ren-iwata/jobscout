# ---- AgentFront v0.1 環境変数 ----

# Anthropic APIキー（未設定かつ MOCK_MODE 未指定の場合、起動時にモックへフォールバック）
ANTHROPIC_API_KEY=

# 管理画面（/admin）パスワード。必ず変更すること
ADMIN_PASSWORD=change-me

# 1 を設定すると LLM を呼ばずスクリプト応答で動作（デモ・自己テスト用）
MOCK_MODE=

# モデルID（省略時は src/lib/ai/models.ts の既定 = claude-sonnet-5）
AF_MODEL_CONVERSATION=
AF_MODEL_PROPOSAL=

# データ保存先（省略時 ./data）
AF_DATA_DIR=

# Postgres接続文字列（設定するとファイル保存の代わりにPostgresを使用。Vercel等の本番用）
# Supabase Transaction pooler (6543) を推奨。例: postgres://postgres.xxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
